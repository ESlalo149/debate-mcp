{
  "name": "debate-mcp",
  "version": "1.0.0",
  "private": true,
  "author": "ESlalo149",
  "license": "MIT",
  "description": "Shared MCP debate room and autopilot for OpenCode and Antigravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/ESlalo149/debate-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "debate",
    "opencode",
    "antigravity",
    "autopilot"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "autopilot": "node dist/autopilot.js",
    "dev": "tsx src/server.ts",
    "debate": "tsx src/autopilot.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
